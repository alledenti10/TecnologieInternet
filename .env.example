# Mantieni nel tuo .env i valori Supabase che già usi.
NUXT_PUBLIC_SUPABASE_URL=https://IL_TUO_PROGETTO.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=LA_TUA_ANON_KEY_O_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=LA_TUA_SERVICE_ROLE_KEY_SOLO_SERVER

# Supabase > Connect: URI PostgreSQL o Session pooler, con password reale.
DATABASE_URL=postgresql://postgres:LA_TUA_PASSWORD@db.IL_TUO_PROGETTO.supabase.co:5432/postgres

AI_API_KEY=LA_TUA_CHIAVE_OPENROUTER
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_MAX_OUTPUT_TOKENS=2000
